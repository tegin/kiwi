<?xml version="1.0" encoding="utf-8" ?>
<odoo noupdate="1">
    <record id="autovacuum_job" model="ir.cron">
        <field name="name">Token: Auto-vacuum log</field>
        <field name="model_id" ref="model_queue_token_location_action" />
        <field name="state">code</field>
        <field name="active" eval="False" />
        <field name="code">model.autovacuum(days=30)</field>
        <field name='interval_number'>1</field>
        <field name='interval_type'>days</field>
        <field name="numbercall">-1</field>
    </record>
    <record id="autocancel_job" model="ir.cron">
        <field name="name">TokenLocation: Auto-cancel</field>
        <field name="model_id" ref="model_queue_token_location" />
        <field name="state">code</field>
        <field name="active" eval="False" />
        <field name="code">model.autocancel(hours=24)</field>
        <field name='interval_number'>1</field>
        <field name='interval_type'>hours</field>
        <field name="numbercall">-1</field>
    </record>
</odoo>
