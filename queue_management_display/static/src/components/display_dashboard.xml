<templates xml:space="preserve">
    <t t-name="queue_management_display.QueueDisplayDashboard" owl="1">
        <style type="text/css" t-esc="data.css" />
        <div t-ref="container" class="o_queue_management_display_view" />
        <audio
            t-ref="audio"
            class="audio_file"
            style="display:none"
            t-att-src="'data:audio/mp3;base64,' + data.audio_file"
            type="audio/mp3"
            t-if="data.audio_file"
        />
    </t>
    <t t-name="queue_management_display.QueueDisplayItem">
        <div class="col-6 o_queue_management_display_token">
            <div t-attf-class="item #{shiny? 'shiny': ''}">
                <h1 t-esc="item.token" />
            </div>
        </div>
        <div class="col-6 o_queue_management_display_location">
            <div t-attf-class="item #{shiny? 'shiny': ''}">
                <h1 t-esc="item.location" />
            </div>
        </div>
    </t>
</templates>
